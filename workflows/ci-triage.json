      "id": "81c760ea-66bf-5077-b333-38152f831cc6",
      "name": "Queue wake-up",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        100
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "ci-triage",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "responseCode": 202,
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ciTriageInternalKey",
          "name": "CI Triage Internal API"
        }
      },
      "webhookId": "f6f9f366-4671-5278-b2dc-6766a9ac9ad2"
    },
    {
      "id": "435485af-b640-5bd4-ba75-88072c201e1d",
      "name": "Recover pending runs",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "b29d64c5-6bed-5b68-89aa-70ed82efd2d9",
      "name": "Manual demo",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        500
      ],
      "parameters": {}
    },
    {
      "id": "95268843-8ae2-52bd-b6d3-e380b24c3527",
      "name": "Claim run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://triage:8000/internal/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 180000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ciTriageInternalKey",
          "name": "CI Triage Internal API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "9a79c667-e601-5b2d-8cfe-47448f45aeab",
      "name": "Run available?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "f1e849b4-6860-5db4-addb-222265cea4e6",
              "leftValue": "={{ $json.has_work }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "0f997d80-a252-50f9-a721-162378082329",
      "name": "Analyze evidence",
