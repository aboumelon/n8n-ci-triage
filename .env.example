# Generate your private .env with: python3 scripts/configure.py
TRIAGE_MODE=demo
PUBLISH_MODE=draft
ALLOWED_REPOSITORIES=demo/ci-sandbox
WEBHOOK_SECRET=generate-with-scripts-configure
INTERNAL_API_KEY=generate-with-scripts-configure
N8N_ENCRYPTION_KEY=generate-with-scripts-configure
POSTGRES_PASSWORD=generate-with-scripts-configure
POSTGRES_USER=automation
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional remote explanation; no model runs on the VM. Disabled by default.
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.apinex.bond/v1
LLM_MODEL=free/deepseek-v4.1-flash
LLM_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=1200
AUTO_CLOSE_ON_SUCCESS=false
N8N_VERSION=2.43.5
HOST_BIND=127.0.0.1
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678
N8N_SECURE_COOKIE=false
N8N_DISPATCH_URL=http://n8n:5678/webhook/ci-triage
TZ=Asia/Tehran
