# Generate your private .env with: python3 scripts/configure.py
TRIAGE_MODE=demo
PUBLISH_MODE=draft
ALLOWED_REPOSITORIES=demo/ci-sandbox
WEBHOOK_SECRET=generate-with-scripts-configure
INTERNAL_API_KEY=generate-with-scripts-configure
N8N_ENCRYPTION_KEY=generate-with-scripts-configure
POSTGRES_PASSWORD=generate-with-scripts-configure
POSTGRES_USER=automation
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTO_CLOSE_ON_SUCCESS=false
N8N_VERSION=2.43.5
HOST_BIND=127.0.0.1
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678
N8N_SECURE_COOKIE=false
N8N_DISPATCH_URL=http://n8n:5678/webhook/ci-triage
TZ=Asia/Tehran
